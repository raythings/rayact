{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rayact.dev/schema/rayact.module.schema.json",
  "title": "Rayact native module manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "name", "package", "jsEntry", "library", "platforms", "architectures", "abiRange", "engineRange", "artifacts", "linkage", "permissions", "configurationSchema", "officialDevApp"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "name": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "package": { "type": "string" },
    "jsEntry": { "type": "string" },
    "library": { "type": "string" },
    "nativeBus": {
      "type": "boolean",
      "description": "False for platform-only packages that do not publish a C ABI module."
    },
    "platforms": { "type": "array", "uniqueItems": true, "items": { "enum": ["android", "ios", "darwin", "linux", "windows", "web"] } },
    "architectures": { "type": "array", "uniqueItems": true, "items": { "enum": ["arm64", "x86_64", "wasm32"] } },
    "abiRange": { "type": "string" },
    "engineRange": { "type": "string" },
    "linkage": { "enum": ["dynamic", "static", "framework"] },
    "permissions": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
    "configurationSchema": { "type": "object" },
    "officialDevApp": { "type": "boolean" },
    "wasmImports": {
      "description": "Host functions this module publishes to WASM workers (ABI 2). Declarative metadata: the module still registers them at runtime via host->register_wasm_imports. signature uses wasm3's grammar, e.g. \"i(iii)\".",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["namespace", "functions"],
        "properties": {
          "namespace": { "type": "string", "minLength": 1 },
          "functions": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "signature"],
              "properties": {
                "name": { "type": "string", "minLength": 1 },
                "signature": { "type": "string", "pattern": "^[viIfF]\\([viIfF]*\\)$" }
              }
            }
          }
        }
      }
    },
    "nativeSources": {
      "description": "Sources for building this module from a source checkout (the dev app does this so plugin edits rebuild with the app). Repo-root relative. Consumers use the prebuilt artifacts instead.",
      "type": "array",
      "items": { "type": "string" }
    },
    "nativeIncludeDirs": {
      "description": "Extra include directories for nativeSources, repo-root relative.",
      "type": "array",
      "items": { "type": "string" }
    },
    "nativeDefines": {
      "description": "Compile definitions applied to nativeSources when building from source.",
      "type": "array",
      "items": { "type": "string" }
    },
    "webSources": {
      "description": "Sources compiled into the Emscripten host for this module, repo-relative. Web has no dynamic loading, so web modules are linked statically.",
      "type": "array",
      "items": { "type": "string" }
    },
    "android": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "project": { "type": "string" },
        "registrationClass": { "type": "string" },
        "dependencies": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
        "manifest": { "type": "string" },
        "sourceDirs": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
        "resourceDirs": { "type": "array", "uniqueItems": true, "items": { "type": "string" } }
      }
    },
    "ios": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sources": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
        "registrationType": { "type": "string" },
        "frameworks": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
        "resources": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
        "infoPlist": {
          "type": "object",
          "additionalProperties": {
            "oneOf": [
              { "type": "string" },
              { "type": "number" },
              { "type": "boolean" },
              { "type": "array", "items": { "type": "string" } }
            ]
          }
        }
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["platform", "architecture", "path", "sha256"],
        "properties": {
          "platform": { "type": "string" },
          "architecture": { "type": "string" },
          "path": { "type": "string" },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "kind": {
            "description": "library (default) is a native binary the loader dlopens or links. wasm is a module-shipped .wasm payload — reserved; nothing consumes it yet.",
            "enum": ["library", "wasm"]
          }
        }
      }
    }
  }
}
