{
  "name": "@rayact/dev-app",
  "version": "0.0.4",
  "type": "module",
  "description": "Standalone Rayact dev app — Expo-Go-style prebuilt host bundling native plugins + the dev client launcher (QR scan, HMR).",
  "license": "MIT",
  "sideEffects": false,
  "bin": {
    "rayact-dev-app": "scripts/install.cjs"
  },
  "scripts": {
    "build:android": "node scripts/with-branding.cjs build --android",
    "build:android:install": "node scripts/with-branding.cjs build --android --install",
    "build:android:install:release": "node scripts/with-branding.cjs build --android --install --release",
    "build:desktop": "node scripts/with-branding.cjs build --release --desktop",
    "start:dev": "node scripts/with-branding.cjs start --dev"
  },
  "files": [
    "scripts/install.cjs",
    "official-app.json",
    "README.md"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/raythings/rayact.git",
    "directory": "apps/dev-app"
  },
  "homepage": "https://github.com/raythings/rayact/tree/main/apps/dev-app#readme",
  "bugs": {
    "url": "https://github.com/raythings/rayact/issues"
  },
  "dependencies": {
    "@rayact/barcode-scanner": "0.0.4",
    "@rayact/clipboard": "0.0.4",
    "@rayact/crash-reporter": "0.0.4",
    "@rayact/dev-client": "0.0.4",
    "@rayact/haptics": "0.0.4",
    "@rayact/image-picker": "0.0.4",
    "@rayact/linking": "0.0.4",
    "@rayact/mmkv": "0.0.4",
    "@rayact/secure-store": "0.0.4",
    "@rayact/sensors": "0.0.4",
    "@rayact/svg": "0.0.4",
    "@rayact/webview": "0.0.4",
    "rayact": "0.0.4",
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "typescript": "^5.8.3"
  },
  "maintainers": [
    "Rayact Maintainers"
  ]
}
