# Maintainer-only: Android arm64/x86_64 engine and module artifacts.
FROM eclipse-temurin:17-jammy

ENV DEBIAN_FRONTEND=noninteractive
ENV ANDROID_HOME=/opt/android-sdk
ENV ANDROID_SDK_ROOT=/opt/android-sdk
ENV PATH="$PATH:$ANDROID_HOME/cmdline-tools/latest/bin:$ANDROID_HOME/platform-tools"

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl unzip git cmake ninja-build python3 ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Android command-line tools + API 36 + latest NDK r27 LTS patch.
RUN mkdir -p "$ANDROID_HOME/cmdline-tools" \
    && curl -fsSL https://dl.google.com/android/repository/commandlinetools-linux-11076708_latest.zip -o /tmp/cmdline-tools.zip \
    && unzip -q /tmp/cmdline-tools.zip -d "$ANDROID_HOME/cmdline-tools" \
    && mv "$ANDROID_HOME/cmdline-tools/cmdline-tools" "$ANDROID_HOME/cmdline-tools/latest" \
    && rm /tmp/cmdline-tools.zip \
    && yes | sdkmanager --licenses >/dev/null \
    && sdkmanager \
        "platform-tools" \
        "platforms;android-36" \
        "build-tools;36.0.0" \
        "ndk;27.3.13750724"

# apps/android pins externalNativeBuild cmake version 4.0.2 — AGP looks it up
# in the SDK, not on PATH. Separate layer so the NDK layer above stays cached.
RUN yes | sdkmanager "cmake;4.0.2" >/dev/null

# AGP's bundled aapt2 is x86_64-only. On arm64 hosts (Apple Silicon + Rosetta)
# the binary can run, but only with the amd64 glibc loader present — jammy's
# arm64 image points at ports.ubuntu.com, which carries no amd64 debs, so add
# the archive.ubuntu.com amd64 sources explicitly. No-ops on amd64 hosts.
RUN if [ "$(dpkg --print-architecture)" = "arm64" ]; then \
      dpkg --add-architecture amd64 \
      && printf 'deb [arch=amd64] http://archive.ubuntu.com/ubuntu jammy main universe\ndeb [arch=amd64] http://archive.ubuntu.com/ubuntu jammy-updates main universe\n' \
         > /etc/apt/sources.list.d/amd64.list \
      && sed -i 's/^deb http/deb [arch=arm64] http/' /etc/apt/sources.list \
      && apt-get update \
      && apt-get install -y --no-install-recommends libc6:amd64 libstdc++6:amd64 zlib1g:amd64 \
      && rm -rf /var/lib/apt/lists/*; \
    fi

WORKDIR /workspace
COPY build-android.sh pack-android.sh /scripts/
RUN chmod +x /scripts/*.sh

ENTRYPOINT ["/scripts/build-android.sh"]
