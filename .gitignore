.DS_Store

# Dependencies
node_modules/

# Build outputs
build/
build-linux/
dist/
.gradle/
.cxx/
*.apk
local.properties
cmake-build-*/
CMakeFiles/
CMakeCache.txt
compile_commands.json

# Generated bundles / bytecode
*.jsc
*.qjsbc
*.rayactpack
# Packaged tarballs (build outputs — produced by npm pack / CI)
*.tgz

# The workspace root is orchestration-only. Package JavaScript and declarations
# belong under packages/*; screenshots belong in test fixtures or release evidence.
/*.js
/*.ts
/*.png
/release1/
/release-tarballs/

# Prebuilt native binaries — shipped via GitHub Releases / npm pack, never git
packages/prebuilt-*/jni/
packages/prebuilt-*/jni-debug/
packages/prebuilt-*/bin/
packages/prebuilt-*/modules/
packages/prebuilt-ios-arm64/RayactEngine.xcframework/
packages/rayact-mmkv/android/
packages/rayact-mmkv/darwin-*/
packages/rayact-mmkv/ios/
packages/rayact-secure-store/android/
packages/rayact-secure-store/darwin-*/
packages/rayact-secure-store/ios/
packages/rayact-crash-reporter/android/
packages/rayact-crash-reporter/darwin-*/
packages/rayact-crash-reporter/ios/

# Build caches / generated app assets
apps/ios/.xcode-derived/
apps/*/rayact-assets/
test-projects/*/rayact-assets/
# Native projects generated by `rayact prebuild` in test projects — regenerable,
# and hundreds of MB of Frameworks/gradle output. No test project tracks these.
test-projects/*/android/
test-projects/*/ios/

# Native module binaries under packages/ — build outputs, rebuilt from source by
# the module build scripts. Keeping them in git bloats the repo and they go
# stale against the sources next to them. (prebuilt-* packages already omit
# their .so/.a for the same reason.)
packages/*/android/**/*.so
packages/*/desktop/**/*.dylib
packages/*/desktop/**/*.so
packages/*/web/**/*.wasm
packages/*/ios/**/*.a
packages/prebuilt-web-wasm/host/*.wasm
__pycache__/
.rayact/
.tmp/

# Web / Emscripten build trees
build-web/
build-web-*/
build-svg/
build-windows-*/
/apps/dev-app/dist-*-test/
/apps/dev-app/dist-windows-bundle/
/third_party/windows-deps/

# Downloaded Windows SDK/CEF inputs and cross-compiled module runtimes.
/.cef-cache/
/.xwin-cache/
packages/*/desktop/**/*.dll
packages/*/desktop/**/*.exe
packages/*/desktop/**/*.pak
packages/*/desktop/**/locales/
packages/*/desktop/**/swiftshader/
packages/*/desktop/**/resources/
packages/*/desktop/**/snapshot_blob.bin
packages/*/desktop/**/v8_context_snapshot.bin
packages/*/desktop/**/icudtl.dat
packages/*/desktop/**/vk_swiftshader_icd.json

# Vitepress docs build/cache (site is regenerated by CI)
docs/.vitepress/dist/
docs/.vitepress/cache/

# Scratch / temp build helpers (not part of the published source)
.tmp-bundler.*
/window_dump.xml
/tamer-screen/
/KeyboardAvoidingView
/Handoff: *.md
/.cursor/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Generated by `rayact prebuild` / `rayact build --android` from the installed
# native modules — regenerated every build, never edited by hand.
apps/android/rayact-module-targets.txt
apps/android/app/src/main/cpp/rayact-modules.cmake
