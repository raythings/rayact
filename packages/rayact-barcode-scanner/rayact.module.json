{
  "$schema": "../../schema/rayact.module.schema.json",
  "schemaVersion": 1,
  "name": "barcode-scanner",
  "package": "@rayact/barcode-scanner",
  "jsEntry": ".",
  "library": "rayact_barcode_scanner",
  "nativeBus": false,
  "platforms": ["android", "ios", "web"],
  "architectures": ["arm64", "x86_64", "wasm32"],
  "abiRange": ">=2 <3",
  "engineRange": ">=0.0.4 <0.1.0",
  "artifacts": [],
  "linkage": "static",
  "permissions": [],
  "configurationSchema": { "type": "object", "additionalProperties": false },
  "officialDevApp": true,
  "android": {
    "dependencies": ["com.google.android.gms:play-services-code-scanner:16.1.0"],
    "manifest": "android/AndroidManifest.xml"
  },
  "ios": {
    "frameworks": ["AVFoundation", "Vision"],
    "infoPlist": {
      "NSCameraUsageDescription": "Scan a QR code to connect to a development server."
    }
  }
}
